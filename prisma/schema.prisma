generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryTree")
  count       Int        @default(0)
  menuOrder   Int        @default(0)
  imageUrl    String?
  icon        String?
  isPublished Boolean    @default(true)
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId, menuOrder])
  @@map("categories")
}

model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  logoUrl   String?
  website   String?
  count     Int       @default(0)
  menuOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@map("brands")
}

model Product {
  id               String         @id @default(cuid())
  sourceId         Int?           @unique
  slug             String         @unique
  name             String
  sku              String?
  brandId          String?
  brand            Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  price            Decimal?       @db.Decimal(12, 2)
  regularPrice     Decimal?       @db.Decimal(12, 2)
  onSale           Boolean        @default(false)
  inStock          Boolean        @default(true)
  shortDescription String?        @db.Text
  description      String?        @db.Text
  images           String[]
  position         Int            @default(0)
  isPublished      Boolean        @default(true)
  categories       Category[]
  tags             Tag[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([isPublished, position])
  @@index([brandId])
  @@map("products")
}

model Tag {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  kind      String    @default("tag")
  products  Product[]
  createdAt DateTime  @default(now())
  @@map("tags")
}

model HeroSlide {
  id         String   @id @default(cuid())
  eyebrow    String?
  badge      String?
  title      String
  copy       String?
  ctaLabel   String   @default("Shop Now")
  href       String
  imageUrl   String
  menuOrder  Int      @default(0)
  isPublished Boolean @default(true)
  updatedAt  DateTime @updatedAt
  @@map("hero_slides")
}

model HomeBlock {
  id          String   @id @default(cuid())
  placement   String
  eyebrow     String?
  title       String
  copy        String?
  priceLabel  String?
  ctaLabel    String?
  href        String?
  imageUrl    String?
  menuOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@index([placement, menuOrder])
  @@map("home_blocks")
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?   @db.Text
  content     String?   @db.Text
  coverUrl    String?
  category    String?
  author      String    @default("utl-online")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@map("posts")
}

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  @@map("settings")
}

model Enquiry {
  id         String       @id @default(cuid())
  reference  String       @unique
  name       String
  phone      String
  email      String?
  address    String?
  notes      String?      @db.Text
  items      Json
  status     String       @default("new")
  source     String       @default("order-form")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status, createdAt])
  @@map("enquiries")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  @@map("newsletter_subscribers")
}
