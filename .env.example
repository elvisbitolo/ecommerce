NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
# Supabase Dashboard > Connect > Connection string > Transaction pooler (port 6543).
# pgbouncer=true makes Prisma borrow one connection per query — ideal for serverless.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"
